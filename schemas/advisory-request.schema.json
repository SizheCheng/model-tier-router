{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model-tier-router.invalid/advisory-request.schema.json",
  "title": "Advisory Request v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "requirements", "preferences", "evidence"],
  "properties": {
    "schema_version": {"type": "string", "const": "model_tier_router_advisory_request_v1alpha1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reasoning_class": {"type": "string", "minLength": 1},
        "min_context_window_class": {"type": "string", "minLength": 1},
        "modalities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "tool_support": {"type": "boolean"},
        "structured_output_support": {"type": "boolean"},
        "maximum_latency_class": {"type": "string", "minLength": 1},
        "maximum_cost_class": {"type": "string", "minLength": 1},
        "privacy_class": {"type": "string", "minLength": 1},
        "deployment_boundary": {"type": "string", "minLength": 1}
      }
    },
    "preferences": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["lower_cost", "lower_latency", "higher_reasoning", "larger_context"]
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context_window": {"type": "boolean"},
        "deployment_boundary": {"type": "boolean"},
        "modalities": {"type": "boolean"},
        "privacy": {"type": "boolean"},
        "structured_output": {"type": "boolean"},
        "tool_support": {"type": "boolean"}
      }
    }
  }
}
