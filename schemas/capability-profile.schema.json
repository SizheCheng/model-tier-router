{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model-tier-router.invalid/capability-profile.schema.json",
  "title": "Logical Capability Profile v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "profile_id", "reasoning_class", "context_window_class",
    "modalities", "tool_support", "structured_output_support", "latency_class",
    "cost_class", "privacy_classes", "deployment_boundaries"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "model_tier_router_capability_profile_v1alpha1"},
    "profile_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "reasoning_class": {"type": "string", "minLength": 1},
    "context_window_class": {"type": "string", "minLength": 1},
    "modalities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "tool_support": {"type": "boolean"},
    "structured_output_support": {"type": "boolean"},
    "latency_class": {"type": "string", "minLength": 1},
    "cost_class": {"type": "string", "minLength": 1},
    "privacy_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "deployment_boundaries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
