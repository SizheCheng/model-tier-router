{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "summary",
    "notes",
    "proposed_files",
    "validation_expectations"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "status": {"type": "string", "enum": ["completed", "blocked", "failed"]},
    "summary": {"type": "string"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "proposed_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_alias", "content"],
        "properties": {
          "target_alias": {"type": "string"},
          "content": {"type": "string"}
        }
      }
    },
    "validation_expectations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "expectation", "required"],
        "properties": {
          "name": {"type": "string"},
          "expectation": {"type": "string"},
          "required": {"type": "boolean"}
        }
      }
    }
  }
}
