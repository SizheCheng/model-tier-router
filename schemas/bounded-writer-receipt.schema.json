{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded writer receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "invocation_id",
    "helper_sha256",
    "policy_sha256",
    "target_alias",
    "relative_path",
    "canonical_workspace",
    "content_encoding",
    "content_byte_count",
    "content_sha256",
    "preexisting_target",
    "post_write_file_sha256",
    "write_status",
    "timestamp",
    "error_classification"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "invocation_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "helper_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_alias": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "relative_path": {"type": "string", "minLength": 1},
    "canonical_workspace": {"type": "string", "minLength": 1},
    "content_encoding": {"const": "base64-utf8"},
    "content_byte_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preexisting_target": {"type": "boolean"},
    "post_write_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "write_status": {"const": "written"},
    "timestamp": {"type": "string", "format": "date-time"},
    "error_classification": {"type": "null"}
  }
}
