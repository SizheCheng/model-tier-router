{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dogfood child final result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "status",
    "summary",
    "changed_paths",
    "tests_run",
    "prohibited_action_attempted",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "case_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "blocked", "failed"]},
    "summary": {"type": "string"},
    "changed_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "tests_run": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status"],
        "properties": {
          "command": {"type": "string"},
          "status": {"enum": ["passed", "failed", "not_run"]}
        }
      }
    },
    "prohibited_action_attempted": {"type": "boolean"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
